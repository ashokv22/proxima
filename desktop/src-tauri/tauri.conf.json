{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Proxima",
  "version": "0.1.0",
  "identifier": "com.localtextworkbench.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    },
    "windows": [
      {
        "label": "main",
        "title": "Proxima",
        "width": 1180,
        "height": 760,
        "minWidth": 820,
        "minHeight": 620,
        "center": true,
        "decorations": true,
        "resizable": true,
        "theme": "Dark",
        "backgroundColor": "#0F172A"
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    }
  }
}
